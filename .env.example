# Supabase Postgres — pooled connection (used at runtime)
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Supabase Postgres — direct connection (used for migrations)
DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Public URL of the deployed app (used in email links, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional — omit to run with Credentials-only auth (no Google sign-in button)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional — omit to have outgoing emails log to the console instead of sending
RESEND_API_KEY=""
EMAIL_FROM="GameStore <onboarding@resend.dev>"

# Required to call /api/cron/* endpoints (Authorization: Bearer <value>)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""
