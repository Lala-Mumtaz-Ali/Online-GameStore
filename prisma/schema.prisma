generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// NextAuth Required Models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  cartItems     CartItem[]
  orders        Order[]
  preorders     Preorder[]
  notifyRequests ReleaseNotifyRequest[]
  notifications Notification[]
  passwordResetTokens PasswordResetToken[]

  // Supports the admin user list's default ordering (newest signups first).
  @@index([createdAt])
}

// Deliberately NOT reusing VerificationToken for password resets.
//
// 1. verifyEmailToken() looks a token up by value alone with no purpose check,
//    so a reset token pasted into /verify-email?token=... would verify the
//    user's email address. Cross-purpose token confusion is a real vuln class.
// 2. sendVerificationEmail() does deleteMany({ identifier: email }), which would
//    silently clobber a pending token of the other kind.
// 3. VerificationToken belongs to the NextAuth PrismaAdapter contract; encoding
//    app semantics into a library-owned table couples us to an upstream schema.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  // SHA-256 of the emailed token, never the token itself. The token is 256 bits
  // of randomBytes entropy so it is not brute-forceable, which makes bcrypt
  // pointless here (and its per-row salt would break this unique-index lookup).
  // Hashing still matters: a leaked backup must not hand out account takeover.
  tokenHash String    @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // Keyed by userId rather than email: User.email is nullable and mutable, and
  // the cascade reaps tokens when an account is deleted.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  USER
  ADMIN
}

// Example Game Store Models
model Game {
  id                    String      @id @default(cuid())
  slug                  String      @unique
  title                 String
  description           String
  price                 Float
  releaseDate           DateTime
  imageUrl              String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  releaseAutomationRanAt DateTime?

  // ---- Imported store metadata -------------------------------------------
  // Populated by scripts/import-steam-games.ts. All optional: a game created by
  // hand in the admin dashboard has none of it, and every page must still work.

  /// Source app id. Unique so re-importing updates rather than duplicates.
  steamAppId            Int?        @unique
  /// Rich store description. Sanitised on import - see the importer.
  aboutHtml             String?
  /// Landscape banner, as opposed to `imageUrl`'s portrait cover.
  headerImage           String?
  developer             String?
  publisher             String?
  metacriticScore       Int?
  metacriticUrl         String?
  /// Total store recommendations, shown as a rough popularity signal.
  reviewCount           Int?
  website               String?
  onWindows             Boolean     @default(true)
  onMac                 Boolean     @default(false)
  onLinux               Boolean     @default(false)

  categories            Category[]
  features              Feature[]
  screenshots           GameScreenshot[]
  trailers              GameTrailer[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  preorders             Preorder[]
  notifyRequests        ReleaseNotifyRequest[]

  // One index per storefront sort option. These accelerate the ORDER BY only.
  // They do NOT speed up the search itself: `contains` compiles to ILIKE '%q%',
  // and a leading wildcard cannot use a btree. See the README for why pg_trgm
  // is the right fix at real scale and why it is not implemented here.
  @@index([title])
  @@index([price])
  @@index([releaseDate])
}

model Category {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  games Game[]

  /// Source genre id, so re-imports match on identity rather than on a name
  /// that could be re-worded upstream. Null for categories created by hand.
  steamGenreId Int? @unique
}

/// A store feature tag: Single-player, Co-op, Steam Achievements, and so on.
///
/// Kept separate from Category because they answer different questions - a
/// genre is what the game *is*, a feature is what it *supports* - and only
/// genres drive the storefront filter.
model Feature {
  id String @id @default(cuid())
  /// Identity is the slug, not the upstream id: Steam lists some features under
  /// two different ids with the same name (55 and 56 are both "DualShock
  /// Controller Support"), which would otherwise produce duplicate rows and
  /// show the same tag twice on a game page.
  slug    String @unique
  name    String
  /// First upstream id seen for this feature. Informational only.
  steamId Int
  games   Game[]
}

model GameScreenshot {
  id           String @id @default(cuid())
  gameId       String
  url          String
  thumbnailUrl String
  /// Preserves the upstream ordering, which is curated rather than arbitrary.
  position     Int

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, position])
  @@index([gameId])
}

model GameTrailer {
  id           String @id @default(cuid())
  gameId       String
  name         String
  thumbnailUrl String
  /// HLS manifest. Steam serves no progressive MP4, so playback needs a
  /// streaming player rather than a plain <video src>.
  hlsUrl       String
  position     Int

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, position])
  @@index([gameId])
}

model CartItem {
  id             String    @id @default(cuid())
  userId         String
  gameId         String
  quantity       Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  reminderSentAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

model Preorder {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  price     Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId])
}

model ReleaseNotifyRequest {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId])
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  status    OrderStatus @default(PAID)
  total     Float
  createdAt DateTime    @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([userId])
}

model OrderItem {
  id       String  @id @default(cuid())
  orderId  String
  gameId   String?
  title    String
  price    Float
  quantity Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  game  Game? @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([gameId])
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}
