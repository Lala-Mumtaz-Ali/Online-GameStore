generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// NextAuth Required Models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  cartItems     CartItem[]
  orders        Order[]
  preorders     Preorder[]
  notifyRequests ReleaseNotifyRequest[]
  notifications Notification[]
  passwordResetTokens PasswordResetToken[]
}

// Deliberately NOT reusing VerificationToken for password resets.
//
// 1. verifyEmailToken() looks a token up by value alone with no purpose check,
//    so a reset token pasted into /verify-email?token=... would verify the
//    user's email address. Cross-purpose token confusion is a real vuln class.
// 2. sendVerificationEmail() does deleteMany({ identifier: email }), which would
//    silently clobber a pending token of the other kind.
// 3. VerificationToken belongs to the NextAuth PrismaAdapter contract; encoding
//    app semantics into a library-owned table couples us to an upstream schema.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  // SHA-256 of the emailed token, never the token itself. The token is 256 bits
  // of randomBytes entropy so it is not brute-forceable, which makes bcrypt
  // pointless here (and its per-row salt would break this unique-index lookup).
  // Hashing still matters: a leaked backup must not hand out account takeover.
  tokenHash String    @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // Keyed by userId rather than email: User.email is nullable and mutable, and
  // the cascade reaps tokens when an account is deleted.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  USER
  ADMIN
}

// Example Game Store Models
model Game {
  id                    String      @id @default(cuid())
  slug                  String      @unique
  title                 String
  description           String
  price                 Float
  releaseDate           DateTime
  imageUrl              String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  releaseAutomationRanAt DateTime?
  categories            Category[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  preorders             Preorder[]
  notifyRequests        ReleaseNotifyRequest[]
}

model Category {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  games Game[]
}

model CartItem {
  id             String    @id @default(cuid())
  userId         String
  gameId         String
  quantity       Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  reminderSentAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

model Preorder {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  price     Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId])
}

model ReleaseNotifyRequest {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId])
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  status    OrderStatus @default(PAID)
  total     Float
  createdAt DateTime    @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([userId])
}

model OrderItem {
  id       String  @id @default(cuid())
  orderId  String
  gameId   String?
  title    String
  price    Float
  quantity Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  game  Game? @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([gameId])
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}
